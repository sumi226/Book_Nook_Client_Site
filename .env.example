# Browser and server-side requests to the Express API.
NEXT_PUBLIC_API_URL=http://localhost:8000

# Better Auth MongoDB storage and session signing.
MONGODB_URI=mongodb://127.0.0.1:27017
DB_NAME=booknook
BETTER_AUTH_SECRET=replace-with-a-random-32-byte-secret

BETTER_AUTH_URL=http://localhost:3000

# Google OAuth web client credentials. Configure both values to enable Google sign-in.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Set IMGBB_API_KEY in book_nook_server/.env and the server Vercel project only.
